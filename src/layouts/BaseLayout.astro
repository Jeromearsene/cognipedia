---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import type { Locale } from "@/i18n/i18n";
import { DEFAULT_LOCALE, getAlternatePath, SUPPORTED_LOCALES } from "@/i18n/i18n";

interface Props {
	title: string;
	description?: string;
	lang?: Locale;
	/** Keep the page out of search engines and skip canonical/alternate links (e.g. the 404 page). */
	noindex?: boolean;
}

const { title, description = "", lang = DEFAULT_LOCALE, noindex = false } = Astro.props;

/** Open Graph locale codes (`og:locale` expects `language_TERRITORY`). */
const OG_LOCALES: Record<Locale, string> = { fr: "fr_FR", en: "en_US" };

// Absolute URLs are required by canonical, hreflang and Open Graph. `Astro.site` is the
// production origin, so preview deployments still point search engines at the real site.
const { currentPath, altLangHrefs } = Astro.locals;
// Prerendered pages see a trailing slash in `currentPath` while the localized alternates do not.
// Strip it (except on the `/fr/` and `/en/` home pages) so every URL matches the sitemap.
const absolute = (path: string) =>
	new URL(/^\/[a-z]{2}\/$/.test(path) ? path : path.replace(/\/+$/, ""), Astro.site).href;
const canonicalUrl = absolute(currentPath);
const alternates = SUPPORTED_LOCALES.map((locale) => ({
	locale,
	href: absolute(getAlternatePath(currentPath, locale, altLangHrefs)),
}));
const defaultAlternate = alternates.find((alternate) => alternate.locale === DEFAULT_LOCALE);
const ogImage = absolute("/og-image.png");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonicalUrl} />
        {alternates.map(({ locale, href }) => (
          <link rel="alternate" hreflang={locale} href={href} />
        ))}
        {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Cognipedia" />
        <meta property="og:title" content={title} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:locale" content={OG_LOCALES[lang]} />
        {SUPPORTED_LOCALES.filter((locale) => locale !== lang).map((locale) => (
          <meta property="og:locale:alternate" content={OG_LOCALES[locale]} />
        ))}
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <!-- Anti-FOUC: apply dark class before paint to prevent theme flash on load -->
    <script is:inline>
      (function() {
        function prefersDark() {
          var stored = localStorage.getItem('theme');
          return stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
        }
        if (prefersDark()) document.documentElement.classList.add('dark');
        // ClientRouter replaces the <html> attributes on navigation, which would drop the `dark`
        // class until hydration. Re-apply it on the incoming document before it is swapped in.
        document.addEventListener('astro:before-swap', function(event) {
          event.newDocument.documentElement.classList.toggle('dark', prefersDark());
        });
      })();
    </script>
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header />
    <main class="mx-auto w-full max-w-6xl flex-1 p-4 sm:p-8" transition:animate="fade">
      <slot />
    </main>
    <Footer />
  </body>
</html>
