---
import { m } from "@/paraglide/messages";
import GithubIcon from "~icons/lucide/github";

const { locale } = Astro.locals;
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-4 text-sm text-text-secondary sm:px-8">
    <span>Cognipedia &copy; {new Date().getFullYear()}</span>
    <nav aria-label={m.footer_nav_label()} class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
      <a
        href={`/${locale}/${m.slug_profile()}`}
        class="text-text-secondary hover:text-text no-underline hover:underline"
      >
        {m.footer_existing_account()}
      </a>
      <a
        href={`/${locale}/${m.slug_legal()}`}
        class="text-text-secondary hover:text-text no-underline hover:underline"
      >
        {m.footer_legal()}
      </a>
      <a
        href={`/${locale}/${m.slug_privacy()}`}
        class="text-text-secondary hover:text-text no-underline hover:underline"
      >
        {m.footer_privacy()}
      </a>
    </nav>
    <a
      href="https://github.com/Jeromearsene/cognipedia"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
      class="text-text-secondary hover:text-text no-underline hover:underline"
    >
      <GithubIcon class="inline-block h-5 w-5 align-text-bottom" />
    </a>
  </div>
</footer>
